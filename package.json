{
    "name":  "petrolumen",
    "private":  true,
    "version":  "1.0.0",
    "type":  "module",
    "scripts":  {
                    "dev":  "vite --host 0.0.0.0 --port 3000",
                    "build":  "tsc \u0026\u0026 vite build --target esnext --minify=false",
                    "lint":  "tsc --noEmit",
                    "test":  "npx tsx src/testRunner.ts \u0026\u0026 vitest run",
                    "test:benchmarks":  "npx tsx src/testRunner.ts",
                    "test:unit":  "vitest run",
                    "typecheck":  "tsc --noEmit",
                    "preview":  "vite preview --port 3000",
                    "package":  "npm run build \u0026\u0026 powershell -Command \"Compress-Archive -Path dist/* -DestinationPath petrolumen-release.zip -Force\"",
                    "tree":  "powershell -NoProfile -ExecutionPolicy Bypass -File tools/Update-Tree.ps1",
                    "tree:watch":  "powershell -NoProfile -ExecutionPolicy Bypass -File tools/Watch-Tree.ps1"
                },
    "dependencies":  {
                         "clsx":  "^2.1.1",
                         "html2canvas":  "^1.4.1",
                         "jspdf":  "^4.2.1",
                         "lucide-react":  "^0.469.0",
                         "react":  "^18.3.1",
                         "react-dom":  "^19.3.1",
                         "recharts":  "^2.15.0",
                         "tailwind-merge":  "^2.6.0"
                     },
    "overrides":  {
                      "dompurify":  "^3.2.4"
                  },
    "devDependencies":  {
                            "@testing-library/jest-dom":  "^7.0.1",
                            "@testing-library/react":  "^16.3.3",
                            "@types/node":  "^22.10.7",
                            "@types/react":  "^18.3.18",
                            "@types/react-dom":  "^19.3.0",
                            "@vitejs/plugin-react":  "^4.3.4",
                            "autoprefixer":  "^10.4.20",
                            "jsdom":  "^29.1.1",
                            "postcss":  "^8.4.49",
                            "tailwindcss":  "^3.4.17",
                            "typescript":  "^5.7.3",
                            "vite":  "^6.0.7",
                            "vitest":  "^5.0.5"
                        }
}
