# Example environment variables for the PetroLúmen frontend
# Copy this file to .env.local and fill in your actual values.
# These variables are accessible in the browser (prefixed with NEXT_PUBLIC_).

# The base URL for the backend API
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Example of another variable:
# NEXT_PUBLIC_FEATURE_FLAG_NEW_THING=true
