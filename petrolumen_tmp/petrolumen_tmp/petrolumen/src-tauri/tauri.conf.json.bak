{
  "package": {
    "productName": "PetroLúmen",
    "version": "0.1.0"
  },
  "tauri": {
    "bundle": {
      "identifier": "com.petrolumen.dev",
      "icon": [],
      "resources": ["bundle/resources/backend.exe"],
      "active": true,
      "targets": ["all"],
      "windows": {
        "digestAlgorithm": "sha256"
      }
    },
    "allowlist": {
      "all": false,
      "fs": { "all": true, "scope": ["**"] },
      "dialog": { "all": true },
      "shell": { "open": true }
    },
    "security": { "csp": "" },
    "updater": { "active": false }
  },
    "build": {
    "beforeDevCommand": "npm --prefix .. run dev",
    "beforeBuildCommand": "npm --prefix .. run build",
    "distDir": "../.next",
    "devUrl": "http://localhost:3000"
  }
}
