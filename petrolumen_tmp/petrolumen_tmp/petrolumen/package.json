{
  "name": "petrolumen",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:standalone": "next build && powershell -NoProfile -ExecutionPolicy Bypass -Command \"Remove-Item -Recurse -Force ./src-tauri/bundle/resources/next -ErrorAction SilentlyContinue; Copy-Item -Recurse -Force ./.next/standalone ./src-tauri/bundle/resources/next; Copy-Item -Force ./package.json ./src-tauri/bundle/resources/next/package.json -ErrorAction SilentlyContinue; if (Test-Path ./src-tauri/bundle/resources/next/package.json) { npm --prefix ./src-tauri/bundle/resources/next install --omit=dev }\"",
    "start": "next start",
    "lint": "next lint",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:preview": "tauri build && tauri dev",
    "package:backend": "powershell -ExecutionPolicy Bypass -File ./scripts/package-backend.ps1 || bash ./scripts/package-backend.sh",
    "package:app": "npm run build && npm run package:backend && npm run desktop:build"
  },
