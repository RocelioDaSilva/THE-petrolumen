# Example environment variables (do NOT store real secrets here)
# Copy this file to `.env` and fill with real values.

# FastAPI / app
FASTAPI_SECRET_KEY=change_me_to_a_long_random_value
UVICORN_HOST=127.0.0.1
UVICORN_PORT=8000

# Database (Postgres example)
DATABASE_URL=postgresql://user:password@localhost:5432/petrolumen_db

# Optional: Sentry or monitoring DSN
SENTRY_DSN=

# Optional: API keys
EXTERNAL_API_KEY=
