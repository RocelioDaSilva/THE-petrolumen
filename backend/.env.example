# Configuration for PetroLúmen Backend

# Database URL (SQLAlchemy format)
# For SQLite (local file):
DATABASE_URL="sqlite:///./reservoir_data.db"
# For PostgreSQL:
# DATABASE_URL="postgresql://user:password@host:port/database_name"

# JWT Secret Key for encoding and decoding tokens
# This should be a long, random, and secret string in production.
# Example: openssl rand -hex 32
SECRET_KEY="your_jwt_secret_key_here_please_change_me"

# Access Token Expiry Time in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Logging Level (e.g., INFO, DEBUG, WARNING, ERROR)
# LOG_LEVEL="INFO"
# (Note: Logging configuration can be more complex and might involve other settings)
# Currently, logging level is set directly in main.py for basic config.
# For more advanced setup, this could be used by a logging config loader.
