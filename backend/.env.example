# Application Configuration
API_HOST=127.0.0.1
API_PORT=8000
DEBUG_MODE=True
TAURI_ENV=development # Set to "production" in Tauri build environment by the Rust sidecar

# Database Configuration
# DATABASE_URL will be dynamically set by backend/config.py based on TAURI_ENV
# or passed as an environment variable by the Tauri sidecar in production.
# For local development, if this is uncommented, config.py can pick it up.
# DATABASE_URL=sqlite:///./reservoir_data.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost/dbname
# For MySQL: DATABASE_URL=mysql://user:password@localhost/dbname

# Data Management
DATA_CACHE_DIR=./data_cache
MAX_UPLOAD_SIZE=500  # MB
SIMULATION_MAX_WORKERS=4

# Security
SECRET_KEY=please_change_this_in_production_!
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 hours

# Path Configuration (examples, might not be directly used by current Pydantic settings)
GEOLOGICAL_DATA_DIR=./geodata
RESERVOIR_MODELS_DIR=./models
